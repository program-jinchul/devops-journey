{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "mcp__terraform",
      "mcp__github"
    ]
  }
}
